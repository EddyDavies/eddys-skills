#!/bin/bash
# arcopen: open a URL in Arc WITHOUT stealing focus, into a named space.
#
#   arcopen <url> [space-title]
#
# Creates the tab via AppleScript (never `open <url>`), so Arc is not
# activated: no focus steal, no desktop switch. The tab lands in the given
# space (pass "active" to force whichever space is current). Arc briefly
# switches its visible space to the new tab, so the
# previously active space is refocused afterwards (by title, since object
# specifiers go stale after the make). Then notifies via the same
# Ghostty/notification path as notify-web-ready.sh.
#
# If an unpinned tab in the target space already shows the same URL (ignoring
# #fragment or ?query), that tab is reloaded instead of a duplicate being
# opened, so reopening a rebuilt report never stacks tabs. Pinned (saved) tabs
# and other spaces are not checked.
#
# If the named space does not exist (renamed?), the tab opens in the active
# space instead. If Arc scripting is unavailable (not running, stalled, or
# no Automation permission), falls back to notify-web-ready.sh so the URL
# still reaches you on the clipboard.
#
# The target space comes from a line like "Arc space: content" (nothing else
# on the line) in the nearest CLAUDE.local.md, CLAUDE.md, AGENTS.md or
# .claude/CLAUDE.md,
# walking up from the current directory, then from the user's global
# ~/.claude/CLAUDE.local.md and ~/.claude/CLAUDE.md, which act as the personal
# default. Precedence: arg 2, then per-directory (local before tracked), then
# global, then the active space.
#
# CLAUDE.local.md is checked FIRST in each directory and is the right home for
# this: it is the untracked, personal half of a repo's memory, so a public
# repo can point at a private client's space without naming the client in a
# tracked file. Nothing is hardcoded here, so the script is shareable as is.
set -uo pipefail

space_from_file() { # space_from_file <file>
  local s
  [[ -f "$1" ]] || return 1
  s=$(grep -iE '^[-* ]*arc[ -]?space:' "$1" 2>/dev/null | head -1 \
      | sed -E 's/^[^:]*:[[:space:]]*//; s/[[:space:]`"'"'"']*$//; s/^[`"'"'"']*//')
  [[ -n "$s" ]] || return 1
  printf '%s' "$s"
}

find_space() {
  local dir="$PWD"
  while :; do
    space_from_file "$dir/CLAUDE.local.md" && return 0
    space_from_file "$dir/CLAUDE.md" && return 0
    space_from_file "$dir/AGENTS.md" && return 0
    space_from_file "$dir/.claude/CLAUDE.local.md" && return 0
    space_from_file "$dir/.claude/CLAUDE.md" && return 0
    [[ "$dir" == "/" ]] && break
    dir=$(dirname "$dir")
  done
  space_from_file "$HOME/.claude/CLAUDE.local.md" && return 0
  space_from_file "$HOME/.claude/CLAUDE.md" && return 0
  return 1
}

if [[ $# -lt 1 || $# -gt 2 ]]; then
  echo "usage: arcopen <url> [space-title|active]" >&2
  exit 2
fi
url="$1"
# A local file path is accepted too: turn it into a file:// URL so HTML artifacts
# can be surfaced the same way as web pages (Arc needs a real URL).
if [[ "$url" != *://* && -e "$url" ]]; then
  url=$(python3 -c 'import sys,pathlib;print(pathlib.Path(sys.argv[1]).resolve().as_uri())' "$url")
fi
space="${2:-}"
if [[ -z "$space" ]]; then
  space="$(find_space)" || space=""
fi
[[ "$space" == "active" ]] && space=""

notify() { # notify <label> <body>
  # terminal-notifier: clicking jumps to the tab (arcfocus), each new one
  # replaces the last (-group), and it clears itself after 30s unless a newer
  # one has replaced it (the stamp file guards against removing that newer one).
  local tn group=claude-arcopen stamp="${TMPDIR:-/tmp}/arcopen-notify.stamp" id
  tn=$(command -v terminal-notifier || echo /opt/homebrew/bin/terminal-notifier)
  if [[ -x "$tn" ]]; then
    id="$$.$RANDOM"
    printf '%s' "$id" >"$stamp"
    if "$tn" -title "Claude: $1" -message "$2" -group "$group" \
         -execute "$(printf '%q %q %q' "$HOME/.local/bin/arcfocus" "$url" "$space")" >/dev/null 2>&1; then
      ( sleep 30; [[ "$(cat "$stamp" 2>/dev/null)" == "$id" ]] && "$tn" -remove "$group" >/dev/null 2>&1 ) \
        </dev/null >/dev/null 2>&1 &
      disown 2>/dev/null
      return 0
    fi
  fi
  if { true 2>/dev/null >/dev/tty; } 2>/dev/null; then
    printf '\033]777;notify;%s;%s\033\\' "Claude: $1" "$2" >/dev/tty
  else
    osascript -e "display notification \"$2\" with title \"Claude: $1\"" >/dev/null 2>&1
  fi
}

# Kept in a variable (not a heredoc inside a command substitution) because
# macOS bash 3.2 mis-parses quotes in that combination.
read -r -d '' script <<'EOF' || true
on run argv
	set theUrl to item 1 of argv
	set spaceName to item 2 of argv
	with timeout of 8 seconds
		tell application "Arc"
			if (count of windows) is 0 then make new window
			tell front window
				-- Resolve the target space first: the named one, else the active one.
				set targetIdx to 0
				set origTitle to title of active space
				if spaceName is not "" then
					set ts to title of every space
					repeat with i from 1 to (length of ts)
						if (item i of ts) is spaceName then
							set targetIdx to i
							exit repeat
						end if
					end repeat
					-- named space missing: fall through to active space
				end if
				if targetIdx is 0 then
					set ts to title of every space
					repeat with i from 1 to (length of ts)
						if (item i of ts) is origTitle then
							set targetIdx to i
							exit repeat
						end if
					end repeat
				end if
				set targetTitle to title of space targetIdx

				-- Reuse: if an unpinned (Today) tab in the target space already shows
				-- this page (ignoring a #fragment or ?query), reload it instead of
				-- opening a duplicate. Only that space, only unpinned tabs, fetched
				-- in one bulk Apple Event (a per-tab scan of thousands of tabs takes
				-- ~30s and blows the 8s timeout).
				try
					set {us, tids} to {URL, id} of (every tab of space targetIdx whose location is "unpinned")
					repeat with ti from 1 to (length of us)
						set u to item ti of us
						if u is theUrl or u starts with (theUrl & "#") or u starts with (theUrl & "?") then
							tell (first tab of space targetIdx whose id is (item ti of tids)) to reload
							return "reloaded existing tab in space " & targetTitle
						end if
					end repeat
				end try

				tell space targetIdx to make new tab with properties {URL:theUrl}
				if origTitle is not targetTitle then tell space origTitle to focus
				return "opened in space " & targetTitle
			end tell
		end tell
	end timeout
end run
EOF

if pgrep -xq Arc; then
  if result="$(osascript -e "$script" "$url" "$space" 2>&1)"; then
    notify "Page loaded in Arc" "$result: $url"
    echo "arcopen: $result: $url"
    exit 0
  fi
  echo "arcopen: Arc scripting failed ($result); falling back to notify" >&2
else
  echo "arcopen: Arc not running; falling back to notify" >&2
fi

exec bash ~/.claude/hooks/notify-web-ready.sh "$url" "Web page ready"
