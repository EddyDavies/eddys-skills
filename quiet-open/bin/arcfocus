#!/bin/bash
# arcfocus <url> [space-title]
# Click action for arcopen's notification: bring Arc forward on the space the
# tab was opened in and select the tab with that URL (if it still exists).
# Falls back to just activating Arc if the space or tab is gone.
set -uo pipefail
url="${1:-}"
space="${2:-}"

read -r -d '' script <<'APPLESCRIPT' || true
on run argv
	set theUrl to item 1 of argv
	set spaceName to item 2 of argv
	with timeout of 8 seconds
		tell application "Arc"
			activate
			if (count of windows) is 0 then return "no window"
			tell front window
				if spaceName is not "" then
					try
						tell space spaceName to focus
					end try
				end if
				repeat with t in tabs
					if (URL of t) starts with theUrl then
						tell t to select
						return "selected tab"
					end if
				end repeat
			end tell
		end tell
	end timeout
	return "activated Arc"
end run
APPLESCRIPT

osascript -e "$script" "$url" "$space"
