#!/bin/zsh
# Screenshot of the main display, scaled so 1 image pixel = 1 logical point (the
# coordinates `act` takes). Prints the PNG path.
STATE=$HOME/.claude/clear-claude-groups
mkdir -p $STATE/shots
f=$STATE/shots/$(date +%H%M%S)-$RANDOM.png
w=$(osascript -l JavaScript -e 'ObjC.import("AppKit"); $.NSScreen.mainScreen.frame.size.width')
screencapture -x -m "$f" && sips --resampleWidth ${w%.*} "$f" >/dev/null && print $f
